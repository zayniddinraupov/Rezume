# Скопируйте этот файл в .env (локально) или задайте эти переменные
# в настройках проекта на Vercel/хостинге — Settings → Environment Variables.
# НИКОГДА не коммитьте .env и не вписывайте реальные значения в код.

# Токен вашего бота от @BotFather
TELEGRAM_BOT_TOKEN=

# ID группы/чата, куда бот будет слать анкеты (можно узнать через /api/get-chat-id)
TELEGRAM_CHAT_ID=8780268541:AAFjreUJnAJn_wX0-OT6ThEv8RBSCMQu2-o

# Ссылка-приглашение на группу, показывается кнопкой под анкетой (необязательно)
TELEGRAM_GROUP_LINK=https://t.me/+xxxxxxxxxxxxx

# Необязательно: секретный ключ для защиты /api/get-chat-id (?key=...)
ADMIN_DEBUG_KEY=

# Необязательно, но рекомендуется в продакшене: Upstash Redis (бесплатный
# тариф на upstash.com) для настоящего rate-limiting и защиты от дублей,
# который переживает холодные старты serverless-функций. Без этих двух
# переменных используется in-memory fallback (работает, но менее надёжен
# при высокой нагрузке/нескольких инстансах).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Необязательно: URL Google Apps Script Web App для резервного дублирования
# анкет в Google Таблицу на случай сбоя Telegram API. См. комментарий
# в utils/backup.js с инструкцией по настройке.
GOOGLE_SHEETS_WEBHOOK_URL=
