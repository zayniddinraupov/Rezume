# Скопируйте этот файл в .env (локально) или задайте эти переменные
# в настройках проекта на Vercel/хостинге — Settings → Environment Variables.
# НИКОГДА не коммитьте .env и не вписывайте реальные значения в код.

# Токен вашего бота от @BotFather
TELEGRAM_BOT_TOKEN=

# ID группы/чата, куда бот будет слать анкеты (можно узнать через /api/get-chat-id)
TELEGRAM_CHAT_ID=

# Ссылка-приглашение на группу, показывается кнопкой под анкетой в Telegram
# (необязательно). Хранить её нужно ТОЛЬКО здесь, не в коде: кто знает ссылку,
# тот может вступить в группу с анкетами. Если ссылка когда-либо попадала в
# код или в публичный репозиторий — перевыпустите её в Telegram
# (Управление группой → Пригласительные ссылки → отозвать и создать новую).
TELEGRAM_GROUP_LINK=https://t.me/+xxxxxxxxxxxxx

# Служебный эндпоинт /api/get-chat-id работает ТОЛЬКО если задан этот ключ
# (без него он отвечает 404). Ключ передаётся в заголовке x-admin-key:
#   curl -H "x-admin-key: ВАШ_КЛЮЧ" https://ваш-домен/api/get-chat-id
# Получив chat_id, удалите эту переменную — эндпоинт снова отключится.
ADMIN_DEBUG_KEY=

# Необязательно, но рекомендуется в продакшене: Upstash Redis (бесплатный
# тариф на upstash.com) для настоящего rate-limiting и защиты от дублей,
# который переживает холодные старты serverless-функций. Без этих двух
# переменных используется in-memory fallback (работает, но менее надёжен
# при высокой нагрузке/нескольких инстансах).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Необязательно: URL Google Apps Script Web App для резервного дублирования
# анкет в Google Таблицу на случай сбоя Telegram API. См. комментарий
# в utils/backup.js с инструкцией по настройке.
GOOGLE_SHEETS_WEBHOOK_URL=

# Секрет для вебхука выше (длинная случайная строка). Задайте то же значение
# в свойствах скрипта Apps Script и проверяйте его в doPost (пример — в
# utils/backup.js), иначе любой, кто узнает URL, сможет писать в Таблицу.
BACKUP_WEBHOOK_SECRET=

# ВАЖНО для защиты от ботов (Cloudflare Turnstile):
# 1. Зайдите на dashboard.cloudflare.com → Turnstile → Add site
# 2. Домен: ваш домен на проде (для теста можно localhost)
# 3. Скопируйте Site Key — вставьте его в index.html вместо
#    data-sitekey="1x00000000000000000000AA" (тестовый ключ, который
#    ВСЕГДА проходит проверку и не защищает от ботов на проде!)
# 4. Скопируйте Secret Key — вставьте сюда:
TURNSTILE_SECRET_KEY=
# ОБЯЗАТЕЛЬНА в продакшене: без неё сервер НЕ принимает анкеты (отвечает
# «Сервер не настроен»). Вне продакшена (локально, тесты) проверка пропускается.
